# Application
APP_NAME=Mixpost
APP_ENV=production
# Generate with: php artisan key:generate
# NOTE: all social account tokens and service credentials are encrypted with this
# key. If you change it, run `php artisan mixpost:reencrypt-credentials --old-key=...`
# to re-encrypt existing data, otherwise it becomes unreadable.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mixpost
DB_USERNAME=root
DB_PASSWORD=

# Redis (required: powers cache, queue and Laravel Horizon)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache / Queue / Session
CACHE_DRIVER=redis
# Mixpost publishes posts via queued jobs, so a persistent queue is required.
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Mixpost
# Auth guard used to protect the Mixpost UI (defaults to the app's default guard).
MIXPOST_AUTH_GUARD=
# Cache key prefix for Mixpost settings/services.
MIXPOST_CACHE_PREFIX=mixpost
# Multi-tenant mode: when true, users only see/manage their own accounts, posts,
# tags and media. Default (false) is single-tenant (all users share the same data).
MIXPOST_MULTI_TENANT=false
# Filesystem disk used to store uploaded media (configure in config/filesystems.php).
MIXPOST_DISK=
# Dedicated log channel for social-network/third-party errors (optional).
MIXPOST_LOG_CHANNEL=

# Media processing (paths to the ffmpeg/ffprobe binaries, used for video thumbnails)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Mail (used for account-unauthorized and other notifications)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Filesystem / S3 (if storing media on S3-compatible object storage)
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
